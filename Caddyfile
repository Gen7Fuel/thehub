:3000 {
    # Scoped to text-like types on purpose: a compressed response can't serve
    # HTTP byte ranges, which academy video seeking (hls.js via /cdn/*) needs.
    encode {
        zstd
        gzip
        match {
            header Content-Type text/*
            header Content-Type application/json*
            header Content-Type application/javascript*
            header Content-Type application/manifest+json*
            header Content-Type application/xml*
            header Content-Type image/svg+xml*
        }
    }

    log {
        output stdout
        format console
        level DEBUG
    }
    
    root * /usr/share/caddy/dist_current
    file_server

    # === AUTH routes ===
    handle /login-auth/* {
        reverse_proxy auth-backend:5005
    }

    # === WebSocket routes (Socket.IO) ===
    handle /socket.io/* {
        reverse_proxy backend:5000
    }

    # === WebRTC Signaling WebSocket ===
    handle /signaling/* {
        reverse_proxy signaling:5002
    }

    # === API routes ===
    handle /api/* {
        reverse_proxy backend:5000
    }

    # === CDN routes ===
    handle /cdn/* {
        reverse_proxy cdn:5001
    }

    # === Frontend routing (React SPA) ===
    handle {
        try_files {path} /index.html
    }
}