# /etc/gen7-backup/backup.env  (root:root, mode 0600). Names only: never commit real values.

# Destination container URL, no trailing slash. Confirm it from the existing VPS backup script
# before the first real upload.
BACKUP_BLOB_BASE_URL=https://<account>.blob.core.windows.net/<container>

# How uploads authenticate. Recommended: the VM's managed identity. There is no secret to store
# and nothing to renew; see README.md for the one-time Azure setup.
BACKUP_AUTH=managed-identity

# Alternative: a write-only SAS token for that one container (permissions "cw" only: no read, list or
# delete), without the leading "?". It expires and must be rotated. Setting it selects sas mode.
# BACKUP_BLOB_SAS=<sas token>

# Only for a user-assigned identity (a system-assigned identity needs nothing here).
# BACKUP_IDENTITY_CLIENT_ID=<client id>

# Optional.
# BACKUP_BLOB_PREFIX=gen7-vm
# GEN7_BACKUP_KEEP_LOCAL=6
# GEN7_BACKUP_DAILY_HOUR_UTC=07
